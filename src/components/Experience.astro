---
import { experience } from "../data/experience";
import { ChevronsUpDownIcon } from "./ui/chevrons-up-down-icon";

const monthYear = (value: string) => {
  const [year, month] = value.split("-").map(Number);
  return `${String(month).padStart(2, "0")}.${year}`;
};

const duration = (start: string, end: string | null) => {
  const [startYear, startMonth] = start.split("-").map(Number);
  const stop = end ? end.split("-").map(Number) : [new Date().getFullYear(), new Date().getMonth() + 1];
  const months = Math.max(1, (stop[0] - startYear) * 12 + stop[1] - startMonth + 1);
  const years = Math.floor(months / 12);
  const remainingMonths = months % 12;
  return [years ? `${years} year${years === 1 ? "" : "s"}` : "", remainingMonths ? `${remainingMonths} month${remainingMonths === 1 ? "" : "s"}` : ""].filter(Boolean).join(" ");
};
---

<section class="experience" aria-labelledby="experience-title">
  <div class="experience-inner">
    <div class="section-title"><h2 id="experience-title">Experience</h2><span>Where the work happened.</span></div>
    <div class="experience-list">
      {experience.map((item) => (
        <article class="experience-company">
            <div class="company-row">
              <div class="company-identity">
                <img class="company-logo" src={item.logo} alt="" width="36" height="36" />
                <h3>{item.company}</h3>
              </div>
              <p class="location">
                {item.location} <span>({item.workMode})</span>
                {item.end === null && <i role="img" aria-label="Current role"></i>}
              </p>
            </div>
        <details class="experience-entry" open>
          <summary>
            <div class="role-row">
              <span class="role-icon" aria-hidden="true">&lt;/&gt;</span>
              <div class="role-info">
                <strong>{item.role}</strong>
                <p class="role-meta"><span>{item.employmentType}</span><span>{monthYear(item.start)} – {item.end ? monthYear(item.end) : "∞"}</span><span>{duration(item.start, item.end)}</span></p>
              </div>
              <span class="chevron" aria-hidden="true">
                <ChevronsUpDownIcon width={16} height={16} strokeWidth={1.5} />
              </span>
            </div>
          </summary>
          <div class="details-content">
            <div class="details-inner">
            <ul class="points">{item.points.map((point) => <li>{point}</li>)}</ul>
            </div>
          </div>
        </details>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience { padding: 0 24px 72px; font-family: Arial, Helvetica, sans-serif; }
  .experience-inner { max-width: 864px; margin-inline: auto; }
  .section-title { display: flex; align-items: baseline; gap: 8px; padding-bottom: 10px; border-bottom: 1px solid #e5e5e5; }
  h2 { color: #1a1a1a; font-size: 20px; font-weight: 600; line-height: 1.4; }
  .section-title > span { color: #999; font-size: 14px; }
  .experience-list { padding-top: 12px; }
  .experience-entry { border-radius: 8px; }
  .experience-entry summary { display: block; cursor: pointer; list-style: none; }
  .experience-entry summary::-webkit-details-marker { display: none; }
  .experience-entry summary:focus-visible { outline: 2px solid var(--foreground); outline-offset: 4px; border-radius: 4px; }
  .company-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 48px; }
  .company-identity { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .company-logo { flex: 0 0 36px; width: 36px; height: 36px; padding: 5px; border: 1px solid #e5e5e5; border-radius: 9px; background: #fff; object-fit: contain; }
  h3 { overflow-wrap: anywhere; color: #1a1a1a; font-size: 16px; font-weight: 600; line-height: 1.4; }
  .location { display: flex; align-items: center; gap: 5px; flex-shrink: 0; color: #858585; font-size: 12px; }
  .location i { position: relative; width: 7px; height: 7px; margin-inline-start: 3px; border-radius: 50%; background: #30a14e; }
  .location i::after { position: absolute; inset: -3px; border: 1px solid #30a14e; border-radius: inherit; content: ""; animation: active-pulse 2s cubic-bezier(0.23, 1, 0.32, 1) infinite; }
  .role-row { display: flex; align-items: center; gap: 12px; padding-top: 5px; }
  .role-icon { display: grid; flex: 0 0 28px; width: 28px; height: 28px; place-items: center; border: 1px solid #e5e5e5; border-radius: 7px; background: #f7f7f7; color: #777; font-size: 10px; font-weight: 600; }
  .role-info { min-width: 0; flex: 1; }
  .role-info strong { color: #222; font-size: 14px; font-weight: 600; line-height: 1.5; }
  .role-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 2px; color: #85858e; font-size: 12px; }
  .role-meta span + span { padding-inline-start: 8px; border-inline-start: 1px solid #dedee2; }
  .chevron { display: grid; flex: 0 0 32px; width: 32px; height: 32px; place-items: center; border-radius: 8px; color: #85858e; transition-property: color, background-color, transform; transition-duration: 150ms; transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
  .experience-entry[open] .chevron { color: #333; }
  .experience-entry summary:active .chevron { transform: scale(0.96); }
  .details-content { margin-inline-start: 12px; padding: 12px 0 8px 40px; border-inline-start: 1px solid #e5e5e5; }
  .points { display: grid; gap: 9px; margin: 0; padding-inline-start: 20px; list-style: disc; color: #333; font-size: 13px; line-height: 1.6; }
  .points li { padding-inline-start: 4px; }
  .points li::marker { color: #bdbdbd; }
  :global(html.dark) .section-title { border-color: #303030; }
  :global(html.dark) h2, :global(html.dark) h3, :global(html.dark) .role-info strong, :global(html.dark) .points { color: #e8e8e8; }
  :global(html.dark) .company-logo { border-color: #494949; }
  :global(html.dark) .role-icon { border-color: #383838; background: #161616; color: #bbb; }
  :global(html.dark) .experience-entry[open] .chevron { color: #e8e8e8; }
  :global(html.dark) .details-content { border-color: #383838; }
  :global(html.dark) .role-meta span + span { border-color: #45454a; }
  @media (hover: hover) and (pointer: fine) {
    .experience-entry summary:hover .chevron { background: #f5f5f5; color: #333; }
    :global(html.dark) .experience-entry summary:hover .chevron { background: #1d1d1d; color: #e8e8e8; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chevron { transition-property: color, background-color; }
    .experience-entry summary:active .chevron { transform: none; }
    .location i::after { animation: none; opacity: .45; }
  }
  @keyframes active-pulse {
    0% { opacity: .6; transform: scale(.65); }
    75%, 100% { opacity: 0; transform: scale(1.45); }
  }
  @media (max-width: 37.5rem) {
    .experience { padding: 0 20px 56px; }
    .section-title { flex-wrap: wrap; gap: 2px 8px; }
    .section-title > span { font-size: 12px; }
    .company-row { align-items: flex-start; }
    .company-identity { gap: 9px; }
    .company-logo { flex-basis: 32px; width: 32px; height: 32px; }
    h3 { font-size: 14px; }
    .location { max-width: 44%; justify-content: flex-end; flex-wrap: wrap; gap: 3px; padding-top: 4px; font-size: 10px; text-align: end; }
    .role-row { gap: 9px; }
    .details-content { margin-inline-start: 9px; padding-inline-start: 32px; }
    .points { font-size: 12px; }
  }
</style>

<style>
  .experience-company { padding: 16px 0; border-bottom: 1px solid var(--border, #e5e5e5); }
  .company-row { min-height: 24px; margin-bottom: 16px; gap: 12px; }
  .company-logo { width: 24px; height: 24px; flex-basis: 24px; padding: 0; border: 0; border-radius: 50%; background: transparent; filter: grayscale(1); transition: filter 300ms cubic-bezier(.42,0,.58,1); }
  h3 { font-size: 20px; line-height: 24px; font-weight: 500; }
  .location { font-size: 14px; gap: 6px; }
  .location i { width: 6px; height: 6px; flex-shrink: 0; background: #0099ff; }
  .location i::after { inset: -2px; border: 0; background: #0099ff; animation-duration: 1s; }
  .experience-entry { position: relative; }
  .experience-entry::before { content: ""; position: absolute; left: 12px; top: 12px; bottom: 9px; width: 1px; background: var(--border, #e5e5e5); }
  .experience-entry::after { content: ""; position: absolute; left: 12px; bottom: 8px; width: 16px; height: 16px; border-left: 1px solid var(--border, #e5e5e5); border-bottom: 1px solid var(--border, #e5e5e5); border-bottom-left-radius: 4px; pointer-events: none; }
  .experience-entry summary { position: relative; border-radius: 8px; }
  .role-row { align-items: flex-start; gap: 12px; padding-top: 0; }
  .role-icon { position: relative; z-index: 1; width: 24px; height: 24px; flex-basis: 24px; border-radius: 6px; box-shadow: 0 0 0 1px var(--background, white), 0 0 0 2px var(--border, #e5e5e5); }
  .role-info strong { font-size: 16px; line-height: 24px; font-weight: 500; }
  .role-meta { margin-top: 4px; font-size: 14px; line-height: 20px; }
  .chevron { width: 16px; height: 24px; flex-basis: 16px; }
  .details-content { overflow: hidden; padding: 0; margin: 0; border: 0; }
  .details-inner { padding: 12px 0 4px 36px; }
  .points { display: block; padding-left: 24px; font-size: 14px; line-height: 24px; list-style-type: disc; }
  .points li { display: list-item; padding-left: 0; }
  .points li + li { margin-top: 8px; }
  @media (hover: hover) and (pointer: fine) {
    .experience-company:hover .company-logo { filter: grayscale(0); }
    .experience-entry summary:hover { background: color-mix(in srgb, var(--foreground, #111) 4%, transparent); }
  }
  @media (max-width: 640px) {
    .company-row { flex-wrap: wrap; }
    .company-identity { gap: 12px; }
    .location { margin-left: 36px; max-width: none; padding: 0; font-size: 14px; text-align: left; justify-content: flex-start; }
    .company-logo { width: 24px; height: 24px; flex-basis: 24px; }
    h3 { font-size: 20px; }
    .role-row { gap: 12px; }
    .details-content { margin: 0; padding: 0; }
    .points { font-size: 14px; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLDetailsElement>(".experience-entry").forEach((entry) => {
    const summary = entry.querySelector<HTMLElement>("summary");
    const content = entry.querySelector<HTMLElement>(".details-content");

    if (!summary || !content || entry.dataset.animated === "true") return;

    entry.dataset.animated = "true";
    let expanded = entry.open;
    let animation: Animation | null = null;

    summary.addEventListener("click", (event) => {
      event.preventDefault();

      const opening = !expanded;
      expanded = opening;

      if (reduceMotion.matches || event.detail === 0) {
        animation?.cancel();
        animation = null;
        entry.open = opening;
        return;
      }

      const currentHeight = entry.open ? content.getBoundingClientRect().height : 0;
      const computedStyle = getComputedStyle(content);
      const currentOpacity = entry.open ? Number.parseFloat(computedStyle.opacity) : 0;
      const currentTransform = computedStyle.transform === "none"
        ? opening ? "translateY(-4px)" : "translateY(0)"
        : computedStyle.transform;

      animation?.cancel();
      entry.open = true;

      const targetHeight = opening ? content.scrollHeight : 0;
      animation = content.animate(
        [
          { height: `${currentHeight}px`, opacity: currentOpacity, transform: currentTransform },
          { height: `${targetHeight}px`, opacity: opening ? 1 : 0, transform: opening ? "translateY(0)" : "translateY(-4px)" },
        ],
        { duration: 200, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
      );

      animation.addEventListener("finish", () => {
        entry.open = expanded;
        animation = null;
      }, { once: true });
    });
  });
</script>
