<section class="activity" aria-labelledby="activity-title" data-github-activity="ramsyparker" data-state="loading" aria-busy="true">
  <div class="activity-inner">
    <header class="activity-header">
      <h2 id="activity-title">Recent Activity</h2>
    </header>

    <div class="activity-summary" aria-live="polite" aria-atomic="true">
      <div class="activity-summary-skeleton" aria-hidden="true">
        <span class="activity-skeleton-total"></span>
        <span class="activity-skeleton-copy"><span></span><span></span></span>
      </div>
      <div class="activity-summary-content" data-contribution-summary aria-hidden="true">
        <strong data-contribution-total>—</strong>
        <span>contributions on GitHub<br /><span data-contribution-year>this year</span></span>
      </div>
    </div>

    <div class="activity-scroll" tabindex="0" aria-label="GitHub contribution calendar; scroll horizontally to see the full year">
      <div class="activity-calendar" data-contribution-calendar aria-hidden="true">
        <div class="activity-calendar-skeleton" aria-hidden="true">
          <div class="activity-skeleton-weeks"></div>
          <div class="activity-skeleton-months">
            <span></span><span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>
        <div class="activity-calendar-content" data-contribution-content></div>
      </div>
    </div>
    <p class="activity-detail" data-contribution-detail aria-live="polite" aria-atomic="true" aria-hidden="true">
      Active on <strong data-active-days>—</strong> days in <span data-contribution-year-inline>this year</span>. Busiest: <strong data-busiest-count>—</strong> on <span data-busiest-date>—</span>.
    </p>
    <p class="activity-status" data-contribution-status role="status">Loading GitHub activity…</p>
  </div>
</section>

<script>
  type Contribution = { date: string; count: number; level: 0 | 1 | 2 | 3 | 4 };
  type ContributionResponse = { total: Record<string, number>; contributions: Contribution[] };

  const formatter = new Intl.NumberFormat();
  const dateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: "long" });
  const monthFormatter = new Intl.DateTimeFormat(undefined, { month: "short", timeZone: "UTC" });

  document.querySelectorAll<HTMLElement>("[data-github-activity]").forEach(async (section) => {
    const calendar = section.querySelector<HTMLElement>("[data-contribution-calendar]");
    const total = section.querySelector<HTMLElement>("[data-contribution-total]");
    const yearLabel = section.querySelector<HTMLElement>("[data-contribution-year]");
    const status = section.querySelector<HTMLElement>("[data-contribution-status]");
    const summaryContent = section.querySelector<HTMLElement>("[data-contribution-summary]");
    const calendarContent = section.querySelector<HTMLElement>("[data-contribution-content]");
    const detail = section.querySelector<HTMLElement>("[data-contribution-detail]");
    const activeDays = section.querySelector<HTMLElement>("[data-active-days]");
    const busiestCount = section.querySelector<HTMLElement>("[data-busiest-count]");
    const busiestDate = section.querySelector<HTMLElement>("[data-busiest-date]");
    const detailYear = section.querySelector<HTMLElement>("[data-contribution-year-inline]");

    if (!calendar || !total || !yearLabel || !status || !summaryContent || !calendarContent || !detail || !activeDays || !busiestCount || !busiestDate || !detailYear) return;

    try {
      const year = new Date().getFullYear();
      const response = await fetch(`https://github-contributions-api.jogruber.de/v4/ramsyparker?y=${year}`);
      if (!response.ok) throw new Error("Could not load GitHub activity");
      const data = await response.json() as ContributionResponse;
      const contributions = data.contributions;
      if (!Array.isArray(contributions) || contributions.length === 0) throw new Error("No contribution data returned");

      total.textContent = formatter.format(data.total[String(year)] ?? contributions.reduce((sum, day) => sum + day.count, 0));
      yearLabel.textContent = `in ${year}`;
      detailYear.textContent = String(year);
      activeDays.textContent = formatter.format(contributions.filter((day) => day.count > 0).length);
      const busiest = contributions.reduce((best, day) => day.count > best.count ? day : best, contributions[0]);
      busiestCount.textContent = formatter.format(busiest.count);
      busiestDate.textContent = dateFormatter.format(new Date(`${busiest.date}T00:00:00Z`));

      const firstDate = new Date(`${data.contributions[0].date}T00:00:00Z`);
      const leadingDays = firstDate.getUTCDay();
      const days = [
        ...Array.from({ length: leadingDays }, () => null),
        ...contributions,
      ];
      const weekCount = Math.ceil(days.length / 7);
      calendar.style.setProperty("--week-count", String(weekCount));

      const weeks = document.createElement("div");
      weeks.className = "activity-weeks";
      for (let week = 0; week < weekCount; week += 1) {
        const column = document.createElement("div");
        column.className = "activity-week";
        for (let weekday = 0; weekday < 7; weekday += 1) {
          const contribution = days[week * 7 + weekday];
          const cell = document.createElement("span");
          cell.className = "activity-day";
          if (contribution) {
            cell.dataset.level = String(contribution.level);
            cell.title = `${formatter.format(contribution.count)} contribution${contribution.count === 1 ? "" : "s"} on ${dateFormatter.format(new Date(`${contribution.date}T00:00:00Z`))}`;
          } else {
            cell.classList.add("activity-day-empty");
          }
          column.append(cell);
        }
        weeks.append(column);
      }

      const months = document.createElement("div");
      months.className = "activity-months";
      let previousMonth = -1;
      contributions.forEach((contribution, index) => {
        const date = new Date(`${contribution.date}T00:00:00Z`);
        const month = date.getUTCMonth();
        const week = Math.floor((leadingDays + index) / 7);
        if (month !== previousMonth) {
          const label = document.createElement("span");
          label.textContent = monthFormatter.format(date);
          label.style.gridColumn = `${week + 1} / span 2`;
          months.append(label);
          previousMonth = month;
        }
      });

      calendarContent.replaceChildren(weeks, months);
      status.textContent = "";
      requestAnimationFrame(() => {
        summaryContent.removeAttribute("aria-hidden");
        detail.removeAttribute("aria-hidden");
        section.dataset.state = "loaded";
        section.setAttribute("aria-busy", "false");
      });
    } catch {
      status.textContent = "GitHub activity is temporarily unavailable.";
      yearLabel.textContent = "activity unavailable";
      summaryContent.removeAttribute("aria-hidden");
      detail.setAttribute("aria-hidden", "true");
      section.dataset.state = "error";
      section.setAttribute("aria-busy", "false");
    }
  });
</script>

<style>
  .activity { padding: 0 24px 64px; font-family: Arial, Helvetica, sans-serif; }
  .activity-inner { max-width: 864px; margin-inline: auto; }
  .activity-header { margin-bottom: 24px; }
  .activity-header h2 { color: #1a1a1a; font-size: 14px; font-weight: 500; line-height: 1.5; }
  .activity-summary { display: grid; margin-bottom: 20px; color: #737373; font-size: 13px; line-height: 1.35; }
  .activity-summary-skeleton,
  .activity-summary-content { grid-area: 1 / 1; display: flex; align-items: center; gap: 12px; transition: opacity 250ms var(--ease-out); }
  .activity-summary-content { opacity: 0; }
  .activity-summary-content strong { color: #1a1a1a; font-size: 32px; font-weight: 400; letter-spacing: -1.2px; line-height: 1; }
  .activity-skeleton-total { width: 52px; height: 32px; border-radius: 5px; background: #eceef0; }
  .activity-skeleton-copy { display: grid; gap: 5px; }
  .activity-skeleton-copy span { width: 142px; height: 8px; border-radius: 4px; background: #eceef0; }
  .activity-skeleton-copy span:last-child { width: 64px; }
  .activity-scroll { overflow-x: auto; padding: 2px 0 8px; scrollbar-color: #c9c9c9 transparent; scrollbar-width: thin; }
  .activity-scroll:focus-visible { outline: 2px solid var(--foreground); outline-offset: 3px; }
  .activity-calendar { display: grid; width: max-content; min-width: 100%; }
  .activity-calendar-skeleton,
  .activity-calendar-content { grid-area: 1 / 1; transition: opacity 250ms var(--ease-out); }
  .activity-calendar-content { opacity: 0; }
  .activity-skeleton-weeks {
    width: 738px; height: 94px;
    background: radial-gradient(circle at 5px 5px, #ebedf0 0 5px, transparent 5.5px) 0 0 / 14px 14px;
  }
  .activity-skeleton-months { display: grid; grid-template-columns: repeat(12, 1fr); align-items: center; width: 738px; height: 11px; margin-top: 8px; }
  .activity-skeleton-months span { width: 18px; height: 7px; border-radius: 4px; background: #eceef0; }
  .activity[data-state="loaded"] .activity-summary-skeleton,
  .activity[data-state="loaded"] .activity-calendar-skeleton,
  .activity[data-state="error"] .activity-summary-skeleton { opacity: 0; pointer-events: none; }
  .activity[data-state="loaded"] .activity-summary-content,
  .activity[data-state="loaded"] .activity-calendar-content,
  .activity[data-state="error"] .activity-summary-content { opacity: 1; }
  .activity[data-state="error"] .activity-scroll { display: none; }
  :global(.activity-weeks), :global(.activity-months) { display: grid; grid-template-columns: repeat(var(--week-count), 10px); column-gap: 4px; justify-content: space-between; }
  :global(.activity-weeks) { align-items: start; }
  :global(.activity-week) { display: grid; grid-template-rows: repeat(7, 10px); row-gap: 4px; }
  :global(.activity-day) { width: 10px; height: 10px; border-radius: 50%; background: #ebedf0; }
  :global(.activity-day)[data-level="1"] { background: #9be9a8; }
  :global(.activity-day)[data-level="2"] { background: #40c463; }
  :global(.activity-day)[data-level="3"] { background: #30a14e; }
  :global(.activity-day)[data-level="4"] { background: #216e39; }
  :global(.activity-day-empty) { visibility: hidden; }
  :global(.activity-months) { margin-top: 8px; color: #8a8a8a; font-size: 11px; line-height: 1; }
  :global(.activity-months) span { white-space: nowrap; }
  .activity-detail { margin: 4px 0 0; color: #737373; font-size: 13px; line-height: 1.5; }
  .activity-detail strong { color: #1a1a1a; font-weight: 600; }
  .activity-status:empty { display: none; }
  .activity-status { min-height: 16px; margin-top: 8px; color: #8a8a8a; font-size: 11px; line-height: 1.5; }
  :global(html.dark) .activity-header h2,
  :global(html.dark) .activity-summary-content strong,
  :global(html.dark) .activity-detail strong { color: #f0f0f0; }
  :global(html.dark) .activity-summary,
  :global(html.dark) .activity-detail,
  :global(html.dark) :global(.activity-months),
  :global(html.dark) .activity-status { color: #aaa; }
  :global(html.dark) .activity-skeleton-total,
  :global(html.dark) .activity-skeleton-copy span,
  :global(html.dark) .activity-skeleton-months span { background: #2b2b2b; }
  :global(html.dark) .activity-skeleton-weeks { background-image: radial-gradient(circle at 5px 5px, #242424 0 5px, transparent 5.5px); }
  :global(html.dark) :global(.activity-day) { background: #242424; }
  :global(html.dark) :global(.activity-day)[data-level="1"] { background: #0e4429; }
  :global(html.dark) :global(.activity-day)[data-level="2"] { background: #006d32; }
  :global(html.dark) :global(.activity-day)[data-level="3"] { background: #26a641; }
  :global(html.dark) :global(.activity-day)[data-level="4"] { background: #39d353; }

  @media (max-width: 37.5rem) {
    .activity { padding: 0 20px 48px; }
    .activity-header { margin-bottom: 20px; }
    .activity-summary { margin-bottom: 16px; }
    .activity-skeleton-weeks {
      width: 633px; height: 81px;
      background: radial-gradient(circle at 4.5px 4.5px, #ebedf0 0 4.5px, transparent 5px) 0 0 / 12px 12px;
    }
    .activity-skeleton-months { width: 633px; }
    :global(html.dark) .activity-skeleton-weeks { background-image: radial-gradient(circle at 4.5px 4.5px, #242424 0 4.5px, transparent 5px); }
    :global(.activity-weeks), :global(.activity-months) { grid-template-columns: repeat(var(--week-count), 9px); column-gap: 3px; }
    
    :global(.activity-week) { grid-template-rows: repeat(7, 9px); row-gap: 3px; }
    :global(.activity-day) { width: 9px; height: 9px; }
  }
  @media (forced-colors: active) {
    :global(.activity-day) { outline: 1px solid CanvasText; }
    .activity-skeleton-total,
    .activity-skeleton-copy span,
    .activity-skeleton-months span { background: CanvasText; opacity: .25; }
    .activity-skeleton-weeks { background-image: radial-gradient(circle at 5px 5px, CanvasText 0 5px, transparent 5.5px); opacity: .25; }
    .activity-scroll:focus-visible { outline-color: Highlight; }
  }
  @media (prefers-reduced-motion: reduce) {
    .activity-summary-skeleton,
    .activity-summary-content,
    .activity-calendar-skeleton,
    .activity-calendar-content { transition-duration: 200ms; }
  }
</style>
