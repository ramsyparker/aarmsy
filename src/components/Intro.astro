---
import ProjectLink from "./ProjectLink";
import DotBackground from "./DotBackground.astro";
import InlineTooltip from "./InlineTooltip";
import { getImage, Image } from "astro:assets";
import { profile } from "../data/profile";

const studio = profile.studio.preview
  ? {
      ...profile.studio,
      preview: (await getImage({
        src: profile.studio.preview,
        width: 560,
        height: 350,
        quality: "mid",
      })).src,
      previewOptimized: true,
    }
  : profile.studio;
---
<section class="intro" aria-labelledby="profile-name">
  <DotBackground />
  <div class="content">
    <header class="identity">
      <div class="avatar">
        {profile.photo ? <Image src={profile.photo} alt="" width={56} height={56} quality="mid" /> :
          <svg viewBox="0 0 56 56" fill="none" aria-hidden="true"><circle cx="28" cy="21" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M13 47v-5c0-8 7-13 15-13s15 5 15 13v5" stroke="currentColor" stroke-width="1.5"/></svg>}
      </div>
      <div><h1 id="profile-name">{profile.name}</h1><p class="role">{profile.role}</p></div>
    </header>
    <p class="bio">
      I design and build <strong>Web and Android apps</strong>.
      I’m the founder of <ProjectLink project={studio} client:load />, and my projects include{" "}<ProjectLink project={profile.projects[0]} client:load />{" "}and{" "}<a class="other-projects" href="/projects"><span class="project-stack" aria-hidden="true">{profile.projects.slice(1).map(project => <span class="stack-icon"><img src={project.icon} alt="" width="18" height="18" /></span>)}</span><span>other projects</span></a>, sharing the journey on{" "}<InlineTooltip client:load className="instagram" href={profile.instagram.url} label={profile.instagram.handle} icon="/icons/instagram.svg" />.
    </p>
    <p class="workflow">
      I build with{" "}<span class="tools" aria-label="AI tools">
        {profile.tools.map((tool) => <InlineTooltip client:load href={tool.url} label={tool.name} icon={tool.icon} />)}
      </span>{" "}<span>AI, from the first idea to design and code.</span>
    </p>
  </div>
</section>
<style>
  .identity, .bio, .workflow {
    opacity: 1; transform: translateY(0);
    transition: opacity 250ms var(--ease-out), transform 250ms var(--ease-out);
  }
  .bio { transition-delay: 50ms; }
  .workflow { transition-delay: 100ms; }
  @starting-style {
    .identity, .bio, .workflow { opacity: 0; transform: translateY(8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .identity, .bio, .workflow { transform: none; transition-property: opacity; transition-delay: 0ms; }
    @starting-style { .identity, .bio, .workflow { transform: none; } }
  }

  .intro {
    position: relative; isolation: isolate; overflow: hidden;
    padding: 64px 24px 54px; font-family: Arial, Helvetica, sans-serif;
  }
  .content { position: relative; max-width: 864px; margin-inline: auto; }

  .identity { display: flex; align-items: center; gap: 12px; margin-bottom: 25px; }
  .avatar {
    width: 56px; height: 56px; flex-shrink: 0; overflow: hidden;
    border-radius: 50%; color: #96765c;
    background: linear-gradient(145deg, #f6e9d7, #ddc2a5);
    border: 1px solid #e1cdb6;
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }

  /* ── Typography — light ── */
  h1 { font-size: 18px; font-weight: 600; line-height: 1.5; letter-spacing: -.4px; color: #1a1a1a; }
  .role { font-size: 14px; line-height: 1.5; color: #737373; }
  .bio { font-size: 24px; line-height: 1.48; letter-spacing: -.4px; text-wrap: pretty; color: #6b6b6b; }
  strong, .project { font-weight: 400; color: #1a1a1a; }
  a { color: #1a1a1a; text-decoration: none; }
  a:hover { color: #444; }
  a:focus-visible { outline: 2px solid var(--foreground); outline-offset: 4px; border-radius: 4px; }

  /* ── Typography — dark ── */
  :global(.dark) h1 { color: #f0f0f0; }
  :global(.dark) .role { color: #b3b3b3; }
  :global(.dark) .bio { color: #b8b8b8; }
  :global(.dark) strong,
  :global(.dark) .project { color: #e8e8e8; }
  :global(.dark) a { color: #e8e8e8; }
  :global(.dark) a:hover { color: #ffffff; }
  :global(.dark) a:focus-visible { outline-color: #d4d4d4; }

  /* ── Project / stack icons ── */
  .project { display: inline-flex; align-items: baseline; gap: 6px; white-space: nowrap; }
  .project-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; align-self: center;
    border: 1px solid #e5e5e5; border-radius: 7px; background: #fff;
  }
  .project-icon img { object-fit: contain; filter: grayscale(1); }
  .other-projects { display: inline-flex; align-items: baseline; gap: 6px; white-space: nowrap; vertical-align: baseline; }
  .project-stack { align-self: center; display: flex; align-items: center; flex-shrink: 0; height: var(--inline-icon-size); isolation: isolate; }
  .stack-icon {
    position: relative; display: block; flex-shrink: 0;
    width: var(--inline-icon-size); height: var(--inline-icon-size);
    border: 1.5px solid var(--icon-border); border-radius: 32%; background: #fff; overflow: hidden;
  }
  .stack-icon { z-index: 1; }
  .stack-icon:first-child { z-index: 3; }
  .stack-icon:nth-child(2) { z-index: 2; }
  .stack-icon + .stack-icon { margin-inline-start: -5px; }
  .stack-icon img { position: absolute; inset: 0; margin: auto; display: block; width: var(--inline-logo-size); height: var(--inline-logo-size); object-fit: contain; }

  :global(.dark) .project-icon,
  :global(.dark) .stack-icon {
    background: #fff;
    border-color: var(--icon-border);
  }

  /* ── Workflow ── */
  .workflow { margin-top: 25px; display: block; font-size: 14px; line-height: 1.75; color: #737373; }
  :global(.dark) .workflow { color: #b3b3b3; }
  .tools { display: inline-flex; align-items: center; isolation: isolate; margin-inline: 4px; vertical-align: middle; }

  /* ── Responsive ── */
  @media (max-width: 37.5rem) {
    .intro { padding: 36px 20px 32px; }
    .identity { gap: 12px; margin-bottom: 20px; }
    .avatar { width: 48px; height: 48px; }
    h1 { font-size: 1.0625rem; line-height: 1.4; }
    .role { font-size: .8125rem; line-height: 1.5; }
    .bio { font-size: 1.0625rem; line-height: 1.6; letter-spacing: -.25px; text-wrap: auto; }
    .workflow { margin-top: 20px; font-size: .875rem; line-height: 1.75; }
  }
  @media (forced-colors: active) { a:focus-visible { outline-color: Highlight; } }
</style>

