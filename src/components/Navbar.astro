---
import { Button } from "./ui/button";
---

<header class="site-header" id="site-header">
  <nav aria-label="Main navigation" class="navbar">
    <a class="brand" href="/" aria-label="Astro home"><span class="brand-mark">✦</span> Astro</a>
    <div class="nav-links">
      <a href="/projects">Projects</a>
      <a href="/blog">Blog</a>
      <a href="/#contact">Contact</a>
      <Button id="theme-toggle" variant="outline" size="icon" aria-label="Toggle theme" title="Toggle theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.0 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg>
      </Button>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const root = document.documentElement;
  const saved = localStorage.getItem("theme");
  if (saved === "dark" || saved === "light") root.classList.toggle("dark", saved === "dark");
  button?.addEventListener("click", () => {
    const dark = root.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
  });

  const header = document.querySelector<HTMLElement>("#site-header");
  let ticking = false;
  const updateHeader = () => {
    const isScrolled = window.scrollY > 10;
    header?.classList.toggle("is-scrolled", isScrolled);
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      window.requestAnimationFrame(updateHeader);
      ticking = true;
    }
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  updateHeader();
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    padding: 14px 20px;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background 260ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 260ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 260ms cubic-bezier(0.16, 1, 0.3, 1),
      backdrop-filter 260ms cubic-bezier(0.16, 1, 0.3, 1),
      -webkit-backdrop-filter 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Scrolled state: Apple translucent glass material */
  .site-header.is-scrolled {
    background: oklch(1 0 0 / 72%);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom-color: oklch(0 0 0 / 7%);
    box-shadow: 0 1px 3px 0 oklch(0 0 0 / 2%);
  }

  :global(.dark) .site-header {
    background: transparent;
    border-bottom-color: transparent;
  }

  :global(.dark) .site-header.is-scrolled {
    background: oklch(0.09 0 0 / 75%);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom-color: oklch(1 0 0 / 8%);
    box-shadow: 0 1px 3px 0 oklch(0 0 0 / 25%);
  }

  .navbar { max-width: 864px; margin: auto; display: flex; align-items: center; justify-content: space-between; }
  
  .brand {
    display: inline-flex; align-items: center; gap: 8px;
    color: #1a1a1a; font-weight: 650; font-size: 15px; text-decoration: none;
    transition: color 150ms, transform 100ms ease-out;
  }
  :global(.dark) .brand { color: #e8e8e8; }
  .brand:hover { color: #000; }
  :global(.dark) .brand:hover { color: #fff; }
  .brand:active { transform: scale(0.97); }
  .brand-mark { color: #e45b2b; font-size: 1.1rem; }

  .nav-links { display: flex; align-items: center; gap: 20px; }
  .nav-links a {
    color: #6b6b6b; font-size: 14px; text-decoration: none;
    transition: color 150ms, transform 100ms ease-out;
  }
  .nav-links a:hover { color: #1a1a1a; }
  :global(.dark) .nav-links a { color: #b3b3b3; }
  :global(.dark) .nav-links a:hover { color: #e8e8e8; }
  .nav-links a:active { transform: scale(0.97); }

  #theme-toggle {
    color: #6b6b6b;
    border-color: oklch(0 0 0 / 12%);
    transition: color 150ms, border-color 150ms, transform 100ms ease-out;
  }
  :global(.dark) #theme-toggle {
    color: #b3b3b3;
    border-color: oklch(1 0 0 / 10%);
  }
  #theme-toggle:hover { color: #1a1a1a; }
  :global(.dark) #theme-toggle:hover { color: #e8e8e8; }
  #theme-toggle:active { transform: scale(0.94); }
  #theme-toggle svg { width: 15px; height: 15px; }
  .brand:focus-visible, .nav-links a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 4px; }
  #theme-toggle { min-width: 40px; min-height: 40px; }
  .moon { display: none; }
  :global(.dark) .sun { display: none; }
  :global(.dark) .moon { display: block; }

  @media (max-width: 520px) {
    .site-header { padding: 12px 16px; }
    .nav-links { gap: 12px; }
    .nav-links a { font-size: 13px; }
  }

  /* Accessibility & Apple reduced motion/transparency rules */
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
    .brand:active, .nav-links a:active, #theme-toggle:active { transform: none; }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header.is-scrolled {
      background: oklch(1 0 0);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    :global(.dark) .site-header.is-scrolled {
      background: oklch(0.09 0 0);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
